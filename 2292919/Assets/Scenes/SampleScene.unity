  m_Script: {fileID: 11500000, guid: e768e26ead733654da3d2152f677b13b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  newTitle: Title - Nebula
  newAuthor: Author- Fung Hang Limbu
  newDesc: A nebula is a giant cloud of dust and gas in space. Some nebulae (more
    than one nebula) come from the gas and dust thrown out by the explosion of a
    dying star, such as a supernova. Other nebulae are regions where new stars are
    beginning to form. For this reason, some nebulae are called "star nurseries."
